{
    "name": "@laravel-twill-project/website",
    "private": true,
    "type": "module",
    "scripts": {
        "blast": "php artisan blast:launch",
        "build": "vite build",
        "deps:check": "npx npm-check-updates",
        "deps:upgrade": "npx npm-check-updates -u",
        "dev": "vite",
        "lint:css": "sh tools/linters.sh stylelint",
        "lint:js": "sh tools/linters.sh eslint",
        "precommit": "lint-staged",
        "prepare": "husky"
    },
    "lint-staged": {
        "package.json": "npx sort-package-json",
        "**/*": "sh tools/linters.sh conflict-markers",
        "**/*.css": "sh tools/linters.sh stylelint",
        "**/*.{js,jsx,ts,tsx,vue}": "sh tools/linters.sh eslint",
        "**/*.php": "sh tools/linters.sh lint",
        "**/*.{js,jsx,ts,tsx,html,css,php,vue}": "sh tools/linters.sh prettify"
    },
    "dependencies": {
        "@area17/a17-behaviors": "~0.4.5",
        "@area17/a17-helpers": "~3.3.2",
        "@area17/a17-tailwind-plugins": "~4.0.6",
        "@swup/a11y-plugin": "~5.0.0",
        "@swup/body-class-plugin": "~3.2.0",
        "@swup/head-plugin": "~2.3.1",
        "@swup/preload-plugin": "~3.2.11",
        "@swup/scripts-plugin": "~2.1.0",
        "body-scroll-lock-upgrade": "~1.1.0",
        "focus-trap": "~7.6.4",
        "swup": "~4.8.1",
        "wicg-inert": "~3.1.3"
    },
    "devDependencies": {
        "@eslint/compat": "^1.1.1",
        "@eslint/js": "^9.8.0",
        "@nabla/vite-plugin-eslint": "~2.0.5",
        "@prettier/plugin-php": "~0.22.4",
        "@shufo/prettier-plugin-blade": "~1.15.4",
        "autoprefixer": "~10.4.20",
        "eslint": "~9.39.0",
        "eslint-config-prettier": "~9.1.0",
        "eslint-plugin-simple-import-sort": "~12.1.1",
        "eslint-plugin-unused-imports": "~4.1.1",
        "globals": "^15.14.0",
        "husky": "~9.1.4",
        "laravel-vite-plugin": "~1.2.0",
        "lint-staged": "~15.5.2",
        "postcss": "~8.5.1",
        "postcss-variable-compress": "~3.0.0",
        "prettier": "~3.4.2",
        "prettier-plugin-tailwindcss": "~0.6.10",
        "sort-package-json": "~2.14.0",
        "stylelint": "~16.13.2",
        "stylelint-config-clean-order": "~6.1.0",
        "stylelint-config-standard": "~36.0.1",
        "stylelint-order": "~6.0.4",
        "tailwindcss": "~3.4.7",
        "vite": "~6.4.1",
        "vite-plugin-dynamic-import": "~1.6.0",
        "vite-plugin-environment": "~1.1.3",
        "vite-plugin-manifest-sri": "~0.2.0"
    },
    "engines": {
        "node": ">=20",
        "npm": ">=10",
        "yarn": "please-use-npm"
    }
}
