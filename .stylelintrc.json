{
    "extends": [
        "stylelint-config-standard",
        "stylelint-config-clean-order"
    ],
    "rules": {
        "at-rule-no-unknown": [
            true,
            {
                "ignoreAtRules": [
                    "tailwind",
                    "apply",
                    "variants",
                    "responsive",
                    "screen"
                ]
            }
        ],
        "import-notation": "string",
        "no-descending-specificity": null
    },
    "ignoreFiles": [
        "vendor/**/*",
        "node_modules/**/*",
        "storage/**/*",
        "public/build/**/*",
        "public/assets/admin/**/*",
        "public/assets/twill/**/*",
        "public/vendor/**/*"
    ]
}
