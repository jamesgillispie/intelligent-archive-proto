APP_NAME="%project-name%"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://%slug-project-name%.test
VITE_APP_URL=%slug-project-name%.test
ADMIN_APP_URL=http://admin.%slug-project-name%.test

# DATABASE
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=%slug-project-name%
DB_USERNAME=postgres
DB_PASSWORD=

# SESSION
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# CACHING & QUEUE
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ASSETS STORAGE
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# TWILL ASSETS
FILE_LIBRARY_ENDPOINT_TYPE=s3
MEDIA_LIBRARY_IMAGE_SERVICE="A17\\Twill\\Services\\MediaLibrary\\Glide"
GLIDE_USE_SOURCE_DISK=true
GLIDE_USE_CACHE_DISK=true
GLIDE_USE_STREAMED_RESPONSE_FOR_ORIGINAL_MEDIA=true
GLIDE_KEEP_TRANSPARENCY=true

# MAILER
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME} (${APP_ENV}"

# COOKIE CONSENT
AXEPTIO_CLIENT_ID=

# TRACKING
GA4_MEASUREMENT_ID=
CLARITY_TRACKING_ID=

# SITEMAP
SITEMAP_STATIC=false

# --- Trails, Not Feeds ---------------------------------------------------
# Placeholder-safe values only. Real secrets live in 1Password
# (.env.1password with op://vault/item/field references) or platform
# secrets in production. See docs/PHASE-0-AUDIT.md §7 and §10.

# NGA OPEN DATA (public dataset — no secrets)
NGA_OPEN_DATA_PATH=
NGA_IMPORT_LIMIT=500
NGA_IMPORT_CLASSIFICATION=Painting
NGA_IMPORT_ACCESSIONED_ONLY=true
NGA_IMPORT_REQUIRE_PRIMARY_IMAGE=true
NGA_IIIF_TIMEOUT=15
NGA_IIIF_RATE_LIMIT_PER_MIN=120
NGA_IMAGE_DOWNLOAD_SIZE=1600

# PINECONE NEXUS (archive knowledge layer; keys are 1Password-only)
NEXUS_DRIVER=fake
NEXUS_INDEX_NAME=archive-local
NEXUS_RETRIEVAL_LIMIT=8
NEXUS_TIMEOUT=10
NEXUS_API_KEY=
NEXUS_ENDPOINT=

# REDIS IRIS (consented visitor memory; credentials are 1Password-only)
REDIS_IRIS_DRIVER=fake
REDIS_IRIS_KEY_PREFIX=ia
REDIS_IRIS_DEFAULT_TTL=1209600
REDIS_IRIS_ANON_SESSION_TTL=3600
REDIS_IRIS_URL=
REDIS_IRIS_API_KEY=

# VISITOR MEMORY & CONSENT
MEMORY_CONSENT_VERSION=2026-07-01
MEMORY_ACTIVE_TRAIL_TTL_DAYS=30
MEMORY_ANON_EXPLORE_RATE_LIMIT=20
MEMORY_EXPORT_FORMAT=json

# RESEARCH TRAILS
TRAILS_MAX_PER_USER=50
TRAILS_MAX_ITEMS=200
TRAILS_EXPANSION_MIN_ITEMS=3
TRAILS_SUGGESTIONS_PER_EXPANSION=6
