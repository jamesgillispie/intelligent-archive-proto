APP_NAME="%project-name%"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://%slug-project-name%.test
VITE_APP_URL=%slug-project-name%.test
ADMIN_APP_URL=http://admin.%slug-project-name%.test

# DATABASE
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=%slug-project-name%
DB_USERNAME=postgres
DB_PASSWORD=

# SESSION
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# CACHING & QUEUE
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# ASSETS STORAGE
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# TWILL ASSETS
FILE_LIBRARY_ENDPOINT_TYPE=s3
MEDIA_LIBRARY_IMAGE_SERVICE="A17\\Twill\\Services\\MediaLibrary\\Glide"
GLIDE_USE_SOURCE_DISK=true
GLIDE_USE_CACHE_DISK=true
GLIDE_USE_STREAMED_RESPONSE_FOR_ORIGINAL_MEDIA=true
GLIDE_KEEP_TRANSPARENCY=true

# MAILER
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME} (${APP_ENV}"

# COOKIE CONSENT
AXEPTIO_CLIENT_ID=

# TRACKING
GA4_MEASUREMENT_ID=
CLARITY_TRACKING_ID=

# SITEMAP
SITEMAP_STATIC=false
