# 1Password Environments file — Trails, Not Feeds (local)
#
# Usage (CLAUDE.md secrets rule — all artisan/queue/import commands):
#   op run --env-file=.env.1password -- php artisan nga:import
#   op run --env-file=.env.1password -- php artisan queue:work
#
# This file is committed. It must contain ONLY:
#   - non-secret literal values, and
#   - op://vault/item/field references for secrets (never real values).
#
# Phase 1 uses no vendor secrets: NGA Open Data is public and both vendor
# drivers default to 'fake'. The op:// references below are the naming
# convention for when live credentials exist; they are commented out until
# the corresponding 1Password items are created, so `op run` works today.
# Environments: local | staging | production (production uses platform
# secrets with the same variable names, not 1Password).

# NGA OPEN DATA (public). NGA_OPEN_DATA_PATH defaults to storage/app/nga
# via config/nga.php; set an absolute path here to override.
NGA_IMPORT_LIMIT=500
NGA_IMPORT_CLASSIFICATION=Painting

# PINECONE NEXUS — switch driver to live only when credentials exist
NEXUS_DRIVER=fake
# NEXUS_API_KEY="op://intelligent-archive/nexus-local/api-key"
# NEXUS_ENDPOINT="op://intelligent-archive/nexus-local/endpoint"

# REDIS IRIS — switch driver to live only when credentials exist
REDIS_IRIS_DRIVER=fake
# REDIS_IRIS_URL="op://intelligent-archive/redis-iris-local/url"
# REDIS_IRIS_API_KEY="op://intelligent-archive/redis-iris-local/api-key"
